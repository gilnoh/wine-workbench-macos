diff --git a/dlls/win32u/vulkan.c b/dlls/win32u/vulkan.c
index 1bb47355..febff173 100644
--- a/dlls/win32u/vulkan.c
+++ b/dlls/win32u/vulkan.c
@@ -3063,6 +3063,25 @@ static void vulkan_init_once(void)
 
 #ifdef SONAME_LIBVULKAN
     vulkan_handle = dlopen( SONAME_LIBVULKAN, RTLD_NOW );
+#ifdef __APPLE__
+    /* A bare soname is resolved through DYLD_FALLBACK_LIBRARY_PATH, and dyld's
+     * default fallback list does not cover Homebrew. Any process that reaches
+     * us without that variable -- Steam spawns its steamsysinfo.exe helper that
+     * way -- then sees no Vulkan at all: vkEnumerateInstanceVersion is missing,
+     * the app assumes 1.0, and gives up. Retry the usual absolute locations so
+     * the driver does not depend on an inherited environment. */
+    if (!vulkan_handle)
+    {
+        static const char *const fallbacks[] =
+        {
+            "/usr/local/lib/libvulkan.1.dylib",     /* x86_64 Homebrew */
+            "/opt/homebrew/lib/libvulkan.1.dylib",  /* arm64 Homebrew  */
+        };
+        unsigned int i;
+        for (i = 0; i < ARRAY_SIZE(fallbacks) && !vulkan_handle; i++)
+            vulkan_handle = dlopen( fallbacks[i], RTLD_NOW );
+    }
+#endif
     if (!vulkan_handle) ERR( "Failed to load %s\n", SONAME_LIBVULKAN );
 #else
     ERR( "Wine was built without Vulkan support.\n" );
