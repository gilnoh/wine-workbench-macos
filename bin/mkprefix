#!/bin/bash
# Create a fresh Wine prefix and point it at the shared Steam library.
#
#   bin/mkprefix <prefix-name> [runtime-name]
#
# The prefix itself stays small (~400MB). Game data lives in library/steamapps,
# which is mounted into the prefix as drive S: so every prefix sees the same
# installed games without duplicating them.

source "$(dirname "$0")/common.sh"

NAME="${1:-}"
RUNTIME="${2:-$DEFAULT_RUNTIME}"
[ -n "$NAME" ] || die "usage: mkprefix <prefix-name> [runtime-name]"

PREFIX_PATH="$PREFIXES_DIR/$NAME"
[ -e "$PREFIX_PATH" ] && die "prefix '$NAME' already exists at $PREFIX_PATH"

BIN="$(runtime_bin "$RUNTIME")"
ARCH="$(arch_prefix "$RUNTIME")"

info "creating prefix '$NAME' with runtime '$RUNTIME'"
mkdir -p "$PREFIX_PATH"

# wineboot initialises the prefix. WINEDLLOVERRIDES silences the mono/gecko
# installer dialogs -- we install those deliberately later if a game needs them.
env WINEPREFIX="$PREFIX_PATH" \
    WINEDLLOVERRIDES="mscoree,mshtml=" \
    PATH="$BIN:$PATH" \
    $ARCH "$BIN/wineboot" --init 2>&1 | grep -viE "^wine: created|fixme:" || true

info "waiting for wineserver to settle"
env WINEPREFIX="$PREFIX_PATH" PATH="$BIN:$PATH" $ARCH "$BIN/wineserver" -w

# Mount the shared Steam library as drive S:.
mkdir -p "$LIBRARY_DIR/steamapps"
ln -sfn "$LIBRARY_DIR" "$PREFIX_PATH/dosdevices/s:"

info "prefix ready: $PREFIX_PATH"
info "  shared library mounted at S:  ->  $LIBRARY_DIR"
