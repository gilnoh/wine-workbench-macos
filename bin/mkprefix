#!/bin/bash
# Create a fresh Wine prefix, provision it, and point it at the shared Steam
# library.
#
#   bin/mkprefix <prefix-name> [runtime-name]
#   bin/mkprefix <prefix-name> --no-provision      skip the winetricks step
#   bin/mkprefix <prefix-name> --cjk               also install CJK fonts
#
# The prefix itself stays small. Game data lives in library/steamapps, mounted
# as drive S: so every prefix sees the same installed games without duplicating
# them.
#
# This script mounts S: and stops there. Steam only *uses* the drive once it is
# registered as a library folder, and this script cannot do that for you: Steam
# owns steamapps/libraryfolders.vdf and rewrites it, so it has to be added from
# the client (Settings > Storage > '+' > S:\). That is one of the two steps only
# a human can do -- the other being the login -- which is why cloning a working
# prefix often beats making a new one. See AGENT_START_HERE.md.

source "$(dirname "$0")/common.sh"

NAME=""
RUNTIME="$DEFAULT_RUNTIME"
PROVISION=1
CJK=0
for arg in "$@"; do
    case "$arg" in
        --no-provision) PROVISION=0 ;;
        --cjk) CJK=1 ;;
        *) if [ -z "$NAME" ]; then NAME="$arg"; else RUNTIME="$arg"; fi ;;
    esac
done
[ -n "$NAME" ] || die "usage: mkprefix <prefix-name> [runtime-name] [--no-provision] [--cjk]"

PREFIX_PATH="$PREFIXES_DIR/$NAME"
[ -e "$PREFIX_PATH" ] && die "prefix '$NAME' already exists at $PREFIX_PATH"

BIN="$(runtime_bin "$RUNTIME")"
# The runtime's own root, i.e. the parent of bin/. Named because the mono lookup
# below got this wrong: it built its glob from "$(dirname "$BIN")/../share/...",
# which is one level too high -- runtimes/share/wine/mono rather than
# runtimes/<runtime>/share/wine/mono -- so it never found an MSI that was there.
RT_ROOT="$(dirname "$BIN")"
DYLD="$(runtime_dyld_path "$RUNTIME"):/usr/lib"

info "creating prefix '$NAME' with runtime '$RUNTIME'"
mkdir -p "$PREFIX_PATH"

# wineboot initialises the prefix. WINEDLLOVERRIDES silences the mono/gecko
# installer dialogs -- we install those deliberately later if a game needs them.
#
# Invoked as `wine wineboot`, NOT as $BIN/wineboot. Upstream's `make install`
# drops a copy of the loader into bin/ for each installed program (wineboot,
# winecfg, msiexec, regedit, ...); **CrossOver's tree deliberately does not** --
# its TOP_INSTALL_LIB is just "fonts loader/wine.inf nls server/wineserver",
# because CrossOver launches Windows programs through its own wineloader. So
# $BIN/wineboot exists on an upstream runtime and is missing on a WineCX one.
# `wine <tool>` works on both.
env WINEPREFIX="$PREFIX_PATH" \
    WINEDLLOVERRIDES="mscoree,mshtml=" \
    PATH="$BIN:$PATH" \
    DYLD_FALLBACK_LIBRARY_PATH="$DYLD" \
    "$BIN/wine" wineboot --init 2>&1 | grep -viE "^wine: created|fixme:" || true

info "waiting for wineserver to settle"
env WINEPREFIX="$PREFIX_PATH" PATH="$BIN:$PATH" "$BIN/wineserver" -w

# Mount the shared Steam library as drive S:. Steam itself creates a
# SteamLibrary/steamapps/ tree underneath once the drive is registered in the
# client, so do not pre-create steamapps/ here -- it only ends up unused.
#
# library/ is gitignored, so a fresh clone does not have it, and `ln -sfn` to a
# missing target succeeds -- leaving a dangling s:. That fails in this project's
# worst shape: the link exists, so `ls -l dosdevices/s:` looks right, while Wine
# resolves it to nothing and S: is simply empty. Create the target instead.
mkdir -p "$LIBRARY_DIR" || die "cannot create $LIBRARY_DIR"
ln -sfn "$LIBRARY_DIR" "$PREFIX_PATH/dosdevices/s:"

# --- provisioning ---------------------------------------------------------
# Every prefix gets these three. All were learned the hard way:
#
#   corefonts       Wine ships only 6 fonts (tahoma, symbol, wingdings,
#                   marlett, webdings). Anything expecting Arial/Times renders
#                   with fallbacks or not at all.
#   d3dcompiler_47  Wine's builtin is a vkd3d-shader wrapper; CEF and many
#                   D3D11 games need the genuine Microsoft compiler. winetricks
#                   also writes the native override into the prefix registry,
#                   so nothing has to force it at launch.
#   vcrun2022       The MSVC 2015-2022 runtime (msvcp140, vcruntime140, concrt140
#                   and friends). Added 2026-08-28 after finding that
#                   prefixes/steam-winecx had it installed BY HAND -- twice,
#                   recorded only in the prefix's own winetricks.log -- while
#                   mkprefix installed nothing of the sort. A prefix built from
#                   these instructions was therefore not the prefix that had been
#                   tested, and the difference was invisible.
#
#                   It is not guesswork that this belongs here: a CrossOver bottle
#                   holding a working Steam carries the same thing, as four MSIs in
#                   drive_c/windows/Installer -- "Microsoft Visual C++ 2022
#                   X86/X64 Minimum/Additional Runtime 14.51.36247". Same
#                   component, same version family.
#
# --cjk adds Chinese/Japanese/Korean fonts. NOT the default: it is ~380 MB and
# several minutes per prefix, and this prefix is supposed to stay small. Measured
# reason to leave it out -- prefixes/steam-winecx has no CJK font at all and runs
# Steam fine; a CrossOver bottle installs them into every bottle regardless, which
# is a different trade-off, not a requirement. Pass --cjk if you need the glyphs.
#
# Wine Mono is installed too when the runtime has it (see below). Plenty of
# games ship a small .NET launcher -- Strategic Command's Launcher.exe imports
# mscoree.dll and nothing else -- and without a .NET runtime it exits 255 with
# no message at all, which looks exactly like the game being broken.
if [ "$PROVISION" = 1 ]; then
    WINETRICKS="$(dirname "$0")/vendor/winetricks"
    if [ ! -x "$WINETRICKS" ]; then
        info "fetching pinned winetricks"
        "$(dirname "$0")/get-winetricks" || die "could not fetch winetricks"
    fi
    # Written as an if, not `[ "$CJK" = 1 ] && VERBS=...`. That form happens to
    # survive `set -e` here (bash exempts every command in an && list but the
    # last), but it survives by accident, and this script has already been killed
    # once by a bare command that returned 1 -- see the mono glob note below.
    VERBS="corefonts d3dcompiler_47 vcrun2022"
    if [ "$CJK" = 1 ]; then VERBS="$VERBS cjkfonts"; fi
    info "provisioning: $VERBS"
    env WINEPREFIX="$PREFIX_PATH" \
        WINE="$BIN/wine" WINESERVER="$BIN/wineserver" \
        DYLD_FALLBACK_LIBRARY_PATH="$DYLD" \
        PATH="$BIN:/opt/homebrew/bin:$PATH" \
        WINEDEBUG=-all \
        "$WINETRICKS" -q $VERBS >/dev/null 2>&1 \
        || die "winetricks provisioning failed (is cabextract installed? see bin/provision-host)"
    # Count with find, not `ls | wc -l`: see the note on the mono glob below --
    # under `set -eo pipefail` an `ls` of a missing directory kills the script.
    n=$(find "$PREFIX_PATH/drive_c/windows/Fonts" -type f 2>/dev/null | wc -l | tr -d ' ')
    info "  fonts installed: $n"

    # Assert vcrun2022 actually landed. winetricks -q swallows a lot, and a verb
    # that silently no-ops is exactly how this gap went unnoticed: the prefix
    # looks provisioned and is not.
    #
    # Do NOT assert on the presence of system32/vcruntime140.dll. That was the
    # first version of this check and it is a control that cannot fail: Wine
    # ships its OWN builtin vcruntime140.dll, so the file is there in a prefix
    # that never saw vcrun2022 (measured on prefixes/control, 2026-08-28).
    # What the verb actually changes is the DllOverride that makes the native
    # copy load at all -- so assert on that.
    #
    # Wait for the wineserver FIRST. Wine keeps the registry in memory and writes
    # user.reg when the server exits, so grepping the file straight after
    # winetricks is a race: it passed on one prefix and failed on the next, with
    # the override present in the file seconds later either way. Measured
    # 2026-08-28 -- the failing run died here and left the prefix without mono.
    env WINEPREFIX="$PREFIX_PATH" PATH="$BIN:$PATH" "$BIN/wineserver" -w
    if grep -q '"\*vcruntime140"' "$PREFIX_PATH/user.reg" 2>/dev/null; then
        info "  vcrun2022 installed (native override registered)"
    else
        die "vcrun2022 did not take -- no '*vcruntime140' DllOverride in user.reg.
  The builtin DLL will be used instead of Microsoft's. Install by hand with:
    WINEPREFIX=$PREFIX_PATH bin/vendor/winetricks -q vcrun2022"
    fi

    # Wine Mono, if the runtime carries it. A source build does not download the
    # mono/gecko MSIs, so bin/get-addons fetches them into share/wine/.
    #
    # Do NOT write this as `mono_msi=$(ls <glob> 2>/dev/null | head -1)`. That is
    # what it used to be, and it made mkprefix die silently right here:
    # common.sh sets `set -eo pipefail`, so when the glob matches nothing `ls`
    # exits 1, pipefail propagates that past the successful `head`, and `set -e`
    # kills the script on the assignment. The 2>/dev/null hides the message, so
    # the run just stops after "fonts installed" with no error and no "prefix
    # ready" -- and the else branch below, whose entire job is to warn that mono
    # is missing, is unreachable in exactly the case it exists for.
    #
    # A glob loop cannot fail, so the branch is reachable either way.
    mono_msi=""
    for m in "$RT_ROOT"/share/wine/mono/wine-mono-*.msi; do
        [ -f "$m" ] && { mono_msi="$m"; break; }
    done
    if [ -n "$mono_msi" ]; then
        info "provisioning: wine-mono ($(basename "$mono_msi"))"
        env WINEPREFIX="$PREFIX_PATH" PATH="$BIN:$PATH" \
            DYLD_FALLBACK_LIBRARY_PATH="$DYLD" WINEDEBUG=-all \
            "$BIN/wine" msiexec /i "$(cd "$(dirname "$mono_msi")" && pwd)/$(basename "$mono_msi")" /qn >/dev/null 2>&1
        env WINEPREFIX="$PREFIX_PATH" PATH="$BIN:$PATH" "$BIN/wineserver" -w
        [ -d "$PREFIX_PATH/drive_c/windows/mono" ] && info "  wine-mono installed" \
            || info "  WARNING: wine-mono install did not take"
    else
        info "  no wine-mono in the runtime -- run bin/get-addons (games with .NET"
        info "  launchers will exit 255 silently without it)"
    fi
fi

info "prefix ready: $PREFIX_PATH"
info "  shared library mounted at S:  ->  $LIBRARY_DIR"
if [ "$NAME" != "${NAME%steam*}" ] || [ -d "$PREFIX_PATH/drive_c/Program Files (x86)/Steam" ]; then
    info ""
    info "  NOTE: mounting S: is not enough -- Steam ignores it until it is added"
    info "  as a library folder. Steam owns that config (steamapps/libraryfolders.vdf)"
    info "  and rewrites it, so add it from the client rather than by hand:"
    info "      Steam > Settings > Storage > '+' > S:\\"
    info "  Otherwise games install into the prefix and a per-game prefix later"
    info "  means downloading them again."
fi
