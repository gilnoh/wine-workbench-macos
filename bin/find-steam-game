#!/usr/bin/env python3
"""Locate an installed game in a Wine prefix's registered Steam libraries."""
import argparse
import json
from pathlib import Path
import re

STRING = r'"((?:\\.|[^"\\])*)"'
def unescape(value):
    return re.sub(r'\\([\\"])', lambda match: match[1], value)
def values(text, key):
    return [unescape(m[1]) for m in re.finditer(r'"' + re.escape(key) + r'"\s*' + STRING, text, re.I)]
def locate(prefix, appid, executable):
    steam = prefix / 'drive_c/Program Files (x86)/Steam'
    libraries = {steam.resolve()}
    folders = steam / 'steamapps/libraryfolders.vdf'
    if folders.is_file():
        for value in values(folders.read_text(encoding='utf-8-sig'), 'path'):
            if re.match(r'^[A-Za-z]:[\\/]', value):
                drive = prefix / 'dosdevices' / (value[0].lower() + ':')
                if drive.exists():
                    libraries.add((drive / value[3:].replace('\\', '/')).resolve())
    matches = []
    for library in sorted(libraries):
        manifest = library / 'steamapps' / f'appmanifest_{appid}.acf'
        if not manifest.is_file():
            continue
        text = manifest.read_text(encoding='utf-8-sig')
        fields = {key: values(text, key) for key in ('appid', 'name', 'installdir', 'buildid')}
        if fields['appid'] != [appid] or len(fields['installdir']) != 1:
            raise ValueError(f'Invalid Steam app manifest: {manifest}')
        common = (manifest.parent / 'common').resolve()
        game = (common / fields['installdir'][0]).resolve()
        if not game.is_relative_to(common):
            raise ValueError(f'Install directory escapes the Steam library: {manifest}')
        if not (game / executable).is_file():
            continue
        matches.append({'appid': appid, 'name': next(iter(fields['name']), ''),
                        'buildid': next(iter(fields['buildid']), ''),
                        'manifest': str(manifest), 'game_directory': str(game),
                        'executable': str(game / executable)})
    if not matches:
        raise ValueError(f'App {appid} is not installed in this prefix. Install it in Steam and wait for the download to finish.')
    if len(matches) != 1:
        raise ValueError(f'Multiple installations of app {appid} found; resolve the duplicate Steam library entries before launching.')
    return matches[0]

def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('prefix', type=Path)
    parser.add_argument('appid')
    parser.add_argument('--exe', required=True, help='Executable path relative to the game directory')
    parser.add_argument('--json', action='store_true')
    args = parser.parse_args()
    if not args.appid.isdecimal() or Path(args.exe).is_absolute() or '..' in Path(args.exe).parts:
        parser.error('Expected a numeric app ID and a relative executable path')
    try:
        result = locate(args.prefix.resolve(), args.appid, args.exe)
    except (ValueError, OSError) as error:
        parser.exit(1, f'error: {error}\n')
    print(json.dumps(result, indent=2) if args.json else result['game_directory'])
if __name__ == '__main__':
    main()
