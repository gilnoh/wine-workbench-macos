#!/bin/bash
# Install a graphics backend's libraries into a prefix (and its runtime).
#
#   bin/backend-install <backend> <prefix> [runtime]
#
# PE DLLs go into the prefix's system32, so each prefix picks its own backend.
# Unix-side libraries (*.so) must live in the runtime tree instead -- Wine only
# looks for unixlibs there. Those are additive and inert unless the matching PE
# DLL is loaded, so sharing them across prefixes is safe.

source "$(dirname "$0")/common.sh"

BACKEND="${1:-}"
PREFIX="${2:-}"
RUNTIME="${3:-$DEFAULT_RUNTIME}"
[ -n "$BACKEND" ] && [ -n "$PREFIX" ] || die "usage: backend-install <backend> <prefix> [runtime]"

SRC="$BACKENDS_DIR/$BACKEND"
[ -d "$SRC" ] || die "no backend '$BACKEND' at $SRC"
PFX="$PREFIXES_DIR/$PREFIX"
[ -d "$PFX" ] || die "no prefix '$PREFIX' -- run: bin/mkprefix $PREFIX"
RT="$RUNTIMES_DIR/$RUNTIME"
[ -d "$RT" ] || die "no runtime '$RUNTIME'"

SYS32="$PFX/drive_c/windows/system32"
SYSWOW="$PFX/drive_c/windows/syswow64"

info "installing $BACKEND -> prefix:$PREFIX runtime:$RUNTIME"

# Refuse to install underneath a live prefix. Installing a backend replaces DLLs
# a running game has mapped; the docs already say not to delete a runtime or
# prefix without checking for live processes, and this is the same hazard.
if pgrep -f "$PREFIXES_DIR/$PREFIX/" >/dev/null 2>&1 \
   || pgrep -f "$RUNTIMES_DIR/$RUNTIME/" >/dev/null 2>&1; then
    die "processes are live on prefix '$PREFIX' or runtime '$RUNTIME'.
  Installing now would swap DLLs underneath them. Stop them first:
    bin/killwine        (NB: also kills a running CrossOver bottle)"
fi

# install_file <src> <destdir> -- atomically, via a temp name in the same
# directory plus mv.
#
# NOT `cp -f`. cp opens the destination with O_TRUNC and rewrites it in place,
# so the inode is preserved and every process that already has the old file
# mmap'd sees its pages change underneath it. mv is a rename: the new content
# gets a new inode and existing mappings keep pointing at the old one, which is
# what you want for a file Wine maps into running processes.
#
# Added 2026-08-14 after a single unexplained failure -- the first launch after
# a cp -f over winemetal.so came up with "d3d11: failed to create device and
# context (80004005)" and the next launch of the same binaries was fine.
# ⚠️ That is a HAZARD REMOVED, not a diagnosis: the failure was never
# reproduced and this is not established as its cause. Do not record it as one.
install_file() {
    local src="$1" destdir="$2" base tmp
    base="$(basename "$src")"
    tmp="$destdir/.$base.new.$$"
    cp -f "$src" "$tmp" || return 1
    mv -f "$tmp" "$destdir/$base"
}

if [ -d "$SRC/x86_64-windows" ]; then
    for f in "$SRC/x86_64-windows"/*.dll; do
        [ -e "$f" ] || continue
        install_file "$f" "$SYS32" && echo "    system32/$(basename "$f")"
    done
fi

if [ -d "$SRC/i386-windows" ] && [ -d "$SYSWOW" ]; then
    for f in "$SRC/i386-windows"/*.dll; do
        [ -e "$f" ] || continue
        install_file "$f" "$SYSWOW" && echo "    syswow64/$(basename "$f")"
    done
fi

# Unixlibs land in the shared runtime. Record what we touched so the mutation
# is traceable -- runtimes are otherwise treated as immutable.
#
# ⚠️ A unixlib's PE half must go into the runtime TOO, not only into the prefix.
# Wine finds a unixlib by taking the path of the *builtin* PE it just loaded and
# swapping .dll -> .so (dlls/ntdll/unix/loader.c, inside find_builtin_dll). A PE
# sitting only in the prefix's system32 is loaded as an ordinary native module,
# so ntdll never derives a path for the .so, __wine_init_unix_call fails in
# DllMain, and the process dies at startup with
#
#   err:module:loader_init "winemetal.dll" failed to initialize, aborting
#   (status c0000142)
#
# which reads like a broken or mismatched backend build rather than a missing
# file. Measured 2026-08-14: DXMT would not load at all until winemetal.dll was
# placed here as well, and it worked immediately afterwards.
if [ -d "$SRC/x86_64-unix" ]; then
    dest="$RT/lib/wine/x86_64-unix"
    for f in "$SRC/x86_64-unix"/*.so; do
        [ -e "$f" ] || continue
        base="$(basename "$f")"
        install_file "$f" "$dest" && echo "    RUNTIME x86_64-unix/$base"
        echo "$base  <- $BACKEND  ($(date '+%Y-%m-%d %H:%M'))" \
            >> "$RT/.backend-installs"

        # The matching PE, if the backend ships one.
        pe="$SRC/x86_64-windows/${base%.so}.dll"
        if [ -e "$pe" ]; then
            install_file "$pe" "$RT/lib/wine/x86_64-windows" \
                && echo "    RUNTIME x86_64-windows/$(basename "$pe")  (unixlib pair)"
            echo "$(basename "$pe")  <- $BACKEND, unixlib pair for $base  ($(date '+%Y-%m-%d %H:%M'))" \
                >> "$RT/.backend-installs"
        fi
    done
fi

info "done. Select it with BACKEND=\"$BACKEND\" in the profile."
