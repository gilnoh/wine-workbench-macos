#!/bin/bash
# Build a Wine runtime from source with our patches applied.
#
#   bin/build-runtime --winecx 26.3.0 [options]
#   bin/build-runtime [--version 11.14] [options]
#
# Options:
#   --jobs N              parallel make jobs (default 8)
#   --with-debug          also apply class 'debug' patches from patches/series
#   --force               build over an existing runtime (also needed after a
#                         FAILED build, which leaves the directory behind)
#   --src DIR             use this source tree instead of the mode's default
#   --name NAME           output runtimes/NAME instead of the derived name
#   --pe-gcc              use mingw-gcc for the PE build (with SSE math forced)
#                         instead of clang -- see "the PE compiler" below
#
# Environment: PE_CC=<compiler> overrides the PE compiler entirely;
#              MACOSX_DEPLOYMENT_TARGET is honoured and recorded;
#              WINECX_SRC overrides the WineCX source tree.
#
# Two modes:
#
#   --winecx <cxver>   CodeWeavers' published CrossOver Wine ("WineCX"). Source
#                      is src/crossover/sources/wine (their layout is
#                      sources/wine, not wine/); output is
#                      runtimes/winecx-<cxver>-x86_64. THIS IS THE PROJECT'S
#                      BASE -- see docs/NEXT.md, "The pivot".
#   --version <wver>   upstream Wine from src/wine-<wver> (or src/wine when it is
#                      checked out at that tag). Kept for the older runtimes.
#
# The output directory name cannot carry three facts -- CrossOver version, Wine
# version and which tarball it came from -- so every runtime gets a PROVENANCE
# file, written and asserted here rather than inferred from a folder name later.
#
# Why this script exists rather than a page of instructions: most of the traps
# below are silent. They do not fail the build, they produce a runtime that is
# subtly wrong -- missing gnutls, mixing architectures, or built from source that
# was never actually patched -- and you find out hours later. See docs/RUNTIME.md.
set -uo pipefail

source "$(dirname "$0")/common.sh"

MODE=upstream
VERSION=11.14
CXVER=""
SRC_OVERRIDE=""
NAME_OVERRIDE=""
JOBS=8
WITH_DEBUG=0
FORCE=0
PE_GCC=0
while [ $# -gt 0 ]; do
    case "$1" in
        --winecx)  MODE=winecx; CXVER="$2"; shift 2 ;;
        --version) VERSION="$2"; shift 2 ;;
        --src)     SRC_OVERRIDE="$2"; shift 2 ;;
        --name)    NAME_OVERRIDE="$2"; shift 2 ;;
        --jobs)    JOBS="$2"; shift 2 ;;
        --with-debug) WITH_DEBUG=1; shift ;;     # also apply class 'debug' patches
        --force)   FORCE=1; shift ;;
        --pe-gcc)  PE_GCC=1; shift ;;            # mingw-gcc + forced SSE math
        *) die "unknown option: $1" ;;
    esac
done

SERIES="$GAMES_ROOT/patches/series"
[ -f "$SERIES" ] || die "no patch series at $SERIES"

# --- resolve source tree and runtime name ---------------------------------
TARBALL=""
if [ "$MODE" = winecx ]; then
    NAME="winecx-$CXVER-x86_64"
    SRC="${WINECX_SRC:-$GAMES_ROOT/src/crossover/sources/wine}"
    TARBALL="$GAMES_ROOT/src/crossover/crossover-sources-$CXVER.tar.gz"
    [ -d "$SRC" ] || die "no WineCX source tree at $SRC
  Get it with:
    cd src/crossover
    curl -O https://media.codeweavers.com/pub/crossover/source/crossover-sources-$CXVER.tar.gz
    tar xzf crossover-sources-$CXVER.tar.gz      # -> sources/wine"

else
    NAME="wine-$VERSION-x86_64"
    # Prefer a version-named tree; fall back to src/wine when it is checked out at
    # the requested version, which is how this repo has been laid out so far.
    SRC="$GAMES_ROOT/src/wine-$VERSION"
    if [ ! -d "$SRC" ]; then
        alt="$GAMES_ROOT/src/wine"
        if [ -d "$alt" ] && [ "$(git -C "$alt" describe --tags 2>/dev/null)" = "wine-$VERSION" ]; then
            SRC="$alt"
            info "using $alt (checked out at wine-$VERSION)"
        else
            die "no source tree for wine-$VERSION
  Looked for: $SRC
          and: $alt (checked out at wine-$VERSION)
  Get one with:
    git clone --depth 1 -b wine-$VERSION https://gitlab.winehq.org/wine/wine.git src/wine-$VERSION"
        fi
    fi
fi
[ -n "$SRC_OVERRIDE" ] && SRC="$SRC_OVERRIDE"
[ -n "$NAME_OVERRIDE" ] && NAME="$NAME_OVERRIDE"

BUILD="$GAMES_ROOT/build/$NAME"
PREFIX="$GAMES_ROOT/runtimes/$NAME"

if [ -e "$PREFIX" ] && [ "$FORCE" = 0 ]; then
    die "runtime already exists: $PREFIX  (use --force to rebuild over it)
  Note a *failed* build also leaves the directory behind, because the library
  bundle has to be in place before configure runs -- so --force is normal here."
fi
# bundle-libs installs into $PREFIX/lib/bundled and configure is seeded with
# those absolute paths, so the prefix must exist before either runs. `make
# install` fills in the rest and leaves lib/bundled alone.
mkdir -p "$PREFIX" || die "cannot create $PREFIX"

# --- source tree: find its git repo, and where it sits inside it -----------
# The patch loop needs git, and one detail decides whether it works at all.
#
# These patches are `git diff` output, so they carry `diff --git a/... b/...`
# headers -- and those paths are relative to the REPOSITORY ROOT. Applied from a
# subdirectory, git therefore looks for <root>/dlls/..., does not find it, prints
#
#   Skipped patch 'dlls/wow64cpu/cpu.c'.
#
# and EXITS 0. Every patch reports as applied and nothing is patched. Measured
# 2026-08-01: it is the `diff --git` header that causes this, not whether the tree
# is its own repo and not whether the files are tracked -- a hand-written patch
# without that header applies fine from a subdirectory, which is why an earlier
# version of this comment blamed the wrong thing.
#
# The fix is to apply from the repository root with --directory=<prefix>, which
# also supports a vendored layout (winecx-sources keeps the tree at sources/wine/).
git -C "$SRC" rev-parse --is-inside-work-tree >/dev/null 2>&1 \
    || die "$SRC is not inside a git repository
  Patching needs git: to apply the series, to prove the tree is otherwise clean,
  and to name the base it was applied to. Either clone winecx-sources, or:
    cd $SRC && git init -b vendor . && git add -A && git commit -m 'pristine'"
SRC_ROOT=$(git -C "$SRC" rev-parse --show-toplevel)
SRC_PREFIX=$(git -C "$SRC" rev-parse --show-prefix)      # "" or e.g. "sources/wine/"
GIT_APPLY=(git -C "$SRC_ROOT" apply)
[ -n "$SRC_PREFIX" ] && GIT_APPLY+=(--directory="$SRC_PREFIX")
[ -n "$SRC_PREFIX" ] && info "source tree is $SRC_PREFIX inside $SRC_ROOT"

# --- host sanity ----------------------------------------------------------
# A missing dependency here shows up as a *silently degraded* runtime, not as a
# build failure, so check before spending twenty minutes compiling.
"$GAMES_ROOT/bin/provision-host" --check >/dev/null 2>&1 \
    || die "host provisioning incomplete -- run bin/provision-host"

# --- bundled libraries ----------------------------------------------------
# Wine dlopens optional libraries by bare soname; macOS has no ld.so.conf
# equivalent and dyld will not find Homebrew. Bundle them and seed configure's
# soname cache with absolute paths into the bundle, so no source patch and no
# environment variable is involved. See docs/RUNTIME.md.
#
# NOTE this does NOT come free from a CrossOver base: their build bundles its own
# way, so a WineCX runtime built with plain flags has bare sonames and silently
# loses freetype, vulkan and gnutls. It is the one genuinely original thing here.
info "bundling host libraries"
"$GAMES_ROOT/bin/bundle-libs" "$NAME" >/dev/null || die "bundle-libs failed"
BUNDLE="$PREFIX/lib/bundled"

SEED=""
# Seed one cache variable per bundled library. Anything not bundled keeps its
# bare soname, which is correct only for libraries in /usr/lib (e.g. libcups).
for pair in "vulkan:libvulkan.1.dylib" "freetype:libfreetype.6.dylib" \
            "gnutls:libgnutls.30.dylib" "SDL2:libSDL2-2.0.0.dylib"; do
    name="${pair%%:*}"; lib="${pair##*:}"
    if [ -e "$BUNDLE/$lib" ]; then
        SEED="$SEED ac_cv_lib_soname_$name=$BUNDLE/$lib"
    else
        info "  note: $lib not bundled, $name keeps its bare soname"
    fi
done
info "  seeding configure with absolute sonames from the bundle"

# --- patches --------------------------------------------------------------
# On a WineCX base, `patches/series` should hold only OUR deltas. A patch that is
# a port of a CW HACK will fail here because the hack is already in the base --
# that failure is the point, and the fix is to delete the patch, not to re-port it.
info "applying patches from $(basename "$SERIES")"
applied=0 skipped=0
PATCHED_FILES=""
APPLIED_LIST=""
while read -r class patch; do
    case "${class:-}" in ''|\#*) continue ;; esac
    case "$patch" in dxmt-*) continue ;; esac          # DXMT builds separately
    if [ "$class" = debug ] && [ "$WITH_DEBUG" = 0 ]; then
        info "  skip  $patch (class debug)"
        skipped=$((skipped+1)); continue
    fi
    p="$GAMES_ROOT/patches/$patch"
    [ -f "$p" ] || die "missing patch: $p"
    if "${GIT_APPLY[@]}" --check "$p" 2>/dev/null; then
        "${GIT_APPLY[@]}" "$p" || die "failed to apply $patch"
        info "  apply $patch ($class)"
        applied=$((applied+1))
    elif "${GIT_APPLY[@]}" --reverse --check "$p" 2>/dev/null; then
        info "  ok    $patch (already applied)"
        applied=$((applied+1))
    else
        die "patch does not apply and is not already applied: $patch
  On a WineCX base this usually means the base already carries the change (if the
  patch is a port of a CW/CX HACK, delete it) or the base moved under it."
    fi
    APPLIED_LIST="$APPLIED_LIST $patch"
    # --numstat only parses the patch, so it works whether or not it applied
    # here; the third field is the path.
    for f in $(git -C "$SRC_ROOT" apply --numstat "$p" 2>/dev/null | awk '{print $3}'); do
        PATCHED_FILES="$PATCHED_FILES ${SRC_PREFIX}$f"
    done
done < "$SERIES"
info "patches: $applied applied, $skipped skipped"

# The tree must now differ from its last commit ONLY by the patches we applied.
# This is what the old script could not check: an earlier session had applied
# CW Hack 24834 directly in src/wine with no patch file, so build-runtime
# silently dropped it on every clean rebuild, and wine-0005 (class debug) sat
# applied in the tree making its skip meaningless.
stray=""
while read -r st f; do
    [ -n "$f" ] || continue
    case " $PATCHED_FILES " in *" $f "*) continue ;; esac
    stray="$stray $f"
done < <(git -C "$SRC_ROOT" status --porcelain -- "${SRC_PREFIX:-.}")
# The converse check, and the important one: every file a patch claimed to touch
# must ACTUALLY be modified. This catches a silent no-op whatever its cause --
# it does not depend on the mechanism described above being correctly understood.
for f in $PATCHED_FILES; do
    [ -n "$(git -C "$SRC_ROOT" status --porcelain -- "$f")" ] || \
        die "a patch reported success but $f is unchanged -- patching silently did nothing.
  This is the failure that produces a runtime which looks patched and is not.
  Check how the series is being applied (see the comment above the git checks)."
done

[ -z "$stray" ] || die "source tree has modifications that no patch in the series accounts for:$stray
  Those changes would be built in but would NOT survive a clean rebuild, so the
  runtime would not be reproducible. Either write them up as a patch and add
  them to $SERIES, or discard them:
    git -C $SRC checkout --$stray"
info "  tree differs from $(git -C "$SRC" describe --tags --always 2>/dev/null) only by the series, and every patch really applied"

# --- build ----------------------------------------------------------------
# Everything below must run in an x86_64 shell AND with CC forced, including
# for configure. Plain `gcc` under `arch -x86_64` still targets arm64 here, and
# configure's link tests then fail against the x86_64 Homebrew libraries --
# silently dropping gnutls, freetype and vulkan from the resulting runtime.
# --- the PE compiler, and why it is not mingw-gcc -------------------------
# MEASURED 2026-07-31: with Homebrew's i686-w64-mingw32-gcc, our 32-bit PE DLLs
# compiled floating-point math to **x87** -- dsound.dll came out with 1334 x87
# instructions and ZERO SSE, where CrossOver's shipped DLL has 741 SSE and 52
# x87. Rosetta 2 emulates x87 badly and SSE well, so wine_dsound_mixer burned a
# whole core (100% vs 1.5%) and the game's audio jittered. GCC targeting i386
# defaults to x87; clang targeting i686-windows defaults to SSE, which is both
# what CrossOver ships and what upstream Wine recommends (clang + lld).
#
# configure takes `--with-mingw=<path to clang>` (configure.ac:414) and derives
# --target=i686-windows itself (configure.ac:466), so this is the whole change.
#
# ⚠️ clang is NOT yet proven end to end here: a clang-built runtime produced
# correct SSE code but could not connect to Steam (`EConnect` retried every 50 ms
# forever, no TLS errors -- see docs/NEXT.md). Until that is understood, --pe-gcc
# is the safe route: it keeps the toolchain that works and only fixes the float
# math, which is the one variable that matters here.
PE_CFLAGS_ARG=""
if [ "${PE_GCC:-0}" = 1 ]; then
    MINGW_ARG="--with-mingw"
    PE_CC="i686-w64-mingw32-gcc (SSE forced)"
    PE_CFLAGS_ARG="i386_CFLAGS='-g -O2 -msse2 -mfpmath=sse'"
elif [ -n "${PE_CC:-}" ]; then
    MINGW_ARG="--with-mingw=$PE_CC"
elif [ -x /usr/local/opt/llvm/bin/clang ]; then
    MINGW_ARG="--with-mingw=/usr/local/opt/llvm/bin/clang"
    PE_CC=/usr/local/opt/llvm/bin/clang
else
    # Fall back to mingw-gcc, but force SSE math -- otherwise the i386 PE build
    # silently regresses to x87 and everything float-heavy crawls under Rosetta.
    MINGW_ARG="--with-mingw"
    PE_CC="i686-w64-mingw32-gcc (SSE forced)"
    PE_CFLAGS_ARG="i386_CFLAGS='-g -O2 -msse2 -mfpmath=sse'"
    info "no clang found for PE; using mingw-gcc with -msse2 -mfpmath=sse"
fi
info "PE compiler: $PE_CC"

# GStreamer is ours (bin/build-gstreamer), not Homebrew's, and is required:
# without it Media Foundation opens nothing by default and decodes no video at
# all, and games then fail in ways that look like their own bugs (Fantasy
# General II spins forever at exit). --with-gstreamer makes configure fail
# rather than skip winegstreamer quietly.
#
# --without-ffmpeg matches CrossOver, whose winedmo.so links no libav at all.
# Ours used to link Homebrew's ffmpeg by absolute /usr/local path -- unbundled,
# and only reachable because mfsrcsnk prefers GStreamer anyway.
GST="$GAMES_ROOT/toolchains/$GSTREAMER_TOOLCHAIN"
[ -f "$GST/lib/pkgconfig/gstreamer-1.0.pc" ] \
    || die "toolchains/$GSTREAMER_TOOLCHAIN is not built -- run bin/build-gstreamer first"

# The SDK must belong to the selected toolchain. On a host where the default SDK
# is newer than the linker (CommandLineTools MacOSX27 SDK + Xcode 26.6 ld), every
# link fails with "tapi error: malformed file" -- see bin/build-gstreamer.
SDK="$(DEVELOPER_DIR="$(xcode-select -p)" xcrun --sdk macosx --show-sdk-path)" \
    || die "cannot resolve the SDK for $(xcode-select -p)"
info "SDK: $SDK"

CONFIGURE_ARGS="--build=x86_64-apple-darwin --enable-archs=i386,x86_64 --prefix=$PREFIX --disable-tests --with-vulkan $MINGW_ARG --with-freetype --with-gnutls --with-gstreamer --without-ffmpeg --without-x"
build_script="$(mktemp)"
trap 'rm -f "$build_script"' EXIT
cat > "$build_script" <<EOF
#!/bin/zsh
# A login shell here may export CPATH/LIBRARY_PATH pointing at arm64 Homebrew,
# which clang honours silently. env-build sets the x86_64 ones it wants.
unset CPATH C_INCLUDE_PATH CPLUS_INCLUDE_PATH OBJC_INCLUDE_PATH LIBRARY_PATH
source "$GAMES_ROOT/bin/env-build-x86_64.sh" || exit 1
set -e
export SDKROOT="$SDK"
export PKG_CONFIG_PATH="$GST/lib/pkgconfig:\$PKG_CONFIG_PATH"
export CC="gcc -arch x86_64"
export CXX="g++ -arch x86_64"
mkdir -p "$BUILD"
cd "$BUILD"
# Re-run configure whenever its arguments change, not only on a fresh tree.
# Guarding on "no Makefile" alone meant a changed flag (--with-gstreamer, 2026-10-02)
# would have been silently ignored by every rebuild of an existing build dir.
want_args="$SEED $CONFIGURE_ARGS $PE_CFLAGS_ARG SDKROOT=$SDK"
if [ ! -f Makefile ] || [ "\$(cat .configure-args 2>/dev/null)" != "\$want_args" ]; then
  "$SRC/configure" $SEED $CONFIGURE_ARGS $PE_CFLAGS_ARG
  print -r -- "\$want_args" > .configure-args
fi
make CC="gcc -arch x86_64" -j$JOBS
make install
echo BUILD_OK
EOF
chmod +x "$build_script"

info "building $NAME (jobs=$JOBS) -- this takes a while"
# build/ is gitignored, so it does not exist in a fresh clone. The build script
# creates $BUILD itself, but that runs *after* this redirect opens the log inside
# build/ -- so a clean checkout failed here, twenty minutes of work short of the
# first line of output.
mkdir -p "$GAMES_ROOT/build" || die "cannot create $GAMES_ROOT/build"
log="$GAMES_ROOT/build/$NAME-build.log"
arch -x86_64 /bin/zsh "$build_script" > "$log" 2>&1
grep -q BUILD_OK "$log" || die "build failed -- see $log
  last lines:
$(tail -5 "$log")"

# --- verify ---------------------------------------------------------------
# A build that "succeeded" can still be wrong. Check the things that fail
# silently: the optional dependencies, and that both architectures are present.
info "verifying"
cfg="$BUILD/include/config.h"
for s in SONAME_LIBVULKAN SONAME_LIBFREETYPE SONAME_LIBGNUTLS SONAME_LIBSDL2; do
    grep -q "define $s" "$cfg" || die "configure did not find $s -- runtime would be degraded"
    # A bare soname here means the seeding did not take, and the runtime would
    # silently lose that library in any process without DYLD_FALLBACK_LIBRARY_PATH.
    grep -qE "define $s \"/" "$cfg" || die "$s is a bare soname, not an absolute path -- seeding failed"
done
info "  sonames are absolute paths into the bundle"

# winegstreamer.so LINKS GStreamer (it is not dlopened by soname), so its load
# commands name the toolchain. Point them at the bundle copies.
ws="$PREFIX/lib/wine/x86_64-unix/winegstreamer.so"
[ -f "$ws" ] || die "winegstreamer.so was not built -- GStreamer was not found by configure"
while read -r d; do
    case "$d" in "$GST"/lib/*) ;; *) continue ;; esac
    b="$(basename "$d")"
    # bundle-libs renames GStreamer libraries whose name a Homebrew one already
    # has (libintl.8.dylib: glib's proxy stub vs gettext); follow its map.
    r=$(awk -v b="$b" '$1==b{print $2}' "$BUNDLE/gstreamer-renames" 2>/dev/null)
    b="${r:-$b}"
    [ -e "$BUNDLE/$b" ] || die "winegstreamer.so needs $b, which is not in the bundle"
    install_name_tool -change "$d" "$BUNDLE/$b" "$ws"
done < <(otool -L "$ws" | tail -n +2 | awk '{print $1}')
codesign --force -s - "$ws" >/dev/null 2>&1 || true

# Assert: no Unix-side module links anything outside the system and the bundle.
# This is the general form of the winedmo/ffmpeg gap: a library linked by
# absolute Homebrew path works on the build host and nowhere else, and works
# here only until the next `brew upgrade`.
outside=$(for f in "$PREFIX"/lib/wine/x86_64-unix/*.so "$PREFIX"/bin/wine*; do
              [ -f "$f" ] && otool -L "$f" 2>/dev/null | tail -n +2 | awk -v f="${f##*/}" '{print f": "$1}'
          done | grep -v -E ": (/usr/lib/|/System/|@rpath/|$BUNDLE/)" | sort -u || true)
[ -z "$outside" ] || die "Unix-side modules link libraries outside the bundle:
$outside"
info "  every Unix-side module links only the system and lib/bundled"
# The 32-bit PE build must use SSE for float math, not x87. This is a silent
# failure of exactly the kind this script exists to catch: everything builds and
# runs, and float-heavy 32-bit code is simply ~60x slower under Rosetta. dsound
# is the canary because its mixer is float-heavy and audibly breaks.
canary="$PREFIX/lib/wine/i386-windows/dsound.dll"
if [ -f "$canary" ]; then
    sse=$(objdump -d "$canary" 2>/dev/null | grep -cE '\b(mulss|mulps|addss|addps)\b')
    x87=$(objdump -d "$canary" 2>/dev/null | grep -cE '\b(fmul|fadd|fld)[a-z]*\b')
    [ "${sse:-0}" -gt 0 ] || die "i386 PE float math is x87, not SSE (dsound.dll: $sse SSE, $x87 x87)
  Rosetta 2 emulates x87 badly; this makes float-heavy 32-bit code ~60x slower and
  was the cause of the dsound mixer burning a core. Use clang for the PE build, or
  add -msse2 -mfpmath=sse to i386_CFLAGS. See docs/NEXT.md."
    info "  i386 PE float math: $sse SSE / $x87 x87 instructions in dsound.dll"
fi
for a in x86_64-windows i386-windows x86_64-unix; do
    [ -d "$PREFIX/lib/wine/$a" ] || die "missing arch dir: $a"
done
ver=$(DYLD_FALLBACK_LIBRARY_PATH="$(runtime_dyld_path "$NAME"):/usr/lib" \
      WINEDEBUG=-all "$PREFIX/bin/wine" --version 2>/dev/null)
info "  version:   $ver"
info "  32-bit builtins: $(ls "$PREFIX/lib/wine/i386-windows" | wc -l | tr -d ' ')"
info "  deps:      vulkan freetype gnutls all found"

# --- provenance -----------------------------------------------------------
# A directory name cannot carry three facts (CrossOver version, Wine version,
# which tarball), and we already got that wrong once with wine-cx26.3-x86_64.
# Written here and asserted below, so provenance is checkable rather than
# inferred.
wine_version=$(sed -n 's/^Wine version //p' "$SRC/VERSION" 2>/dev/null)
sha=""
if [ -n "$TARBALL" ] && [ -f "$TARBALL" ]; then
    sha=$(shasum -a 256 "$TARBALL" | awk '{print $1}')
fi
{
    echo "runtime:           $NAME"
    [ "$MODE" = winecx ] && echo "crossover_version: $CXVER"
    echo "wine_version:      ${wine_version:-unknown}"
    echo "wine_reported:     ${ver:-unknown}"
    if [ "$MODE" = winecx ]; then
        echo "source_tarball:    $(basename "${TARBALL:-unknown}")"
        echo "sha256:            ${sha:-unavailable (tarball not on disk)}"
    fi
    # macOS switches framework behaviour on the binary's deployment target
    # ("linked on or after"), so two builds of identical source can behave
    # differently. CrossOver ships minos 10.15; a host-default build gets the
    # host's version. Record it -- it is not visible in the configure line.
    echo "deployment_target: ${MACOSX_DEPLOYMENT_TARGET:-<host default>}"
    echo "pe_compiler:       $PE_CC"
    echo "source_tree:       ${SRC#$GAMES_ROOT/}"
    echo "source_commit:     $(git -C "$SRC" rev-parse HEAD 2>/dev/null)"
    echo "source_base:       $(git -C "$SRC" describe --tags --always 2>/dev/null)"
    echo "patches:          ${APPLIED_LIST:- none}"
    echo "configure:         $CONFIGURE_ARGS"
    echo "built:             $(date -u '+%Y-%m-%dT%H:%M:%SZ')"
    echo "built_by:          bin/build-runtime"
} > "$PREFIX/PROVENANCE"

# Assert it, so a half-written PROVENANCE cannot ship.
for field in wine_version source_commit built; do
    grep -qE "^$field: +\S" "$PREFIX/PROVENANCE" \
        || die "PROVENANCE is missing $field -- refusing to leave an unlabelled runtime"
done
if [ "$MODE" = winecx ]; then
    grep -qE "^crossover_version: +$CXVER\$" "$PREFIX/PROVENANCE" \
        || die "PROVENANCE does not record crossover_version=$CXVER"
fi
info "  PROVENANCE written and asserted"

info "runtime ready: $PREFIX"
