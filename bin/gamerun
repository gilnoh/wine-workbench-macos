#!/bin/bash
# Launch a game from its profile.
#
#   bin/gamerun <profile> [extra args passed to the exe]
#   bin/gamerun <profile> --shell        # drop into a shell with the env set up
#   bin/gamerun <profile> --winecfg      # run winecfg in that prefix
#
# A profile (profiles/<name>.env) selects runtime + prefix + backend + exe.
# Swapping graphics backend is a one-line edit there, which is the whole point:
# the same game, prefix and runtime can be A/B tested across DXMT / DXVK / GL.

source "$(dirname "$0")/common.sh"

PROFILE="${1:-}"
[ -n "$PROFILE" ] || die "usage: gamerun <profile> [args...]"
shift

load_profile "$PROFILE"

[ -d "$PREFIX_PATH" ] || die "prefix '$PREFIX' does not exist -- run: bin/mkprefix $PREFIX"
BIN="$(runtime_bin "$RUNTIME")"


# --- backend --------------------------------------------------------------
# Each backend dir carries a backend.conf defining BACKEND_OVERRIDES and,
# optionally, BACKEND_ENV (extra env assignments) and BACKEND_DYLD_PATHS.
BACKEND_OVERRIDES=""
BACKEND_ENV=()
if [ "$BACKEND" != "none" ]; then
    conf="$BACKENDS_DIR/$BACKEND/backend.conf"
    [ -f "$conf" ] || die "backend '$BACKEND' has no backend.conf at $conf"
    # shellcheck disable=SC1090
    source "$conf"
fi

# Profile-level overrides win over backend defaults; both are merged.
#
# Join with ';' only when BOTH sides are non-empty. The previous form appended
# ";$WINEDLLOVERRIDES" unconditionally, so with BACKEND="none" (empty
# BACKEND_OVERRIDES) the result began with a stray ';' -- and Wine then silently
# ignored the whole list. That cost a wrong conclusion: a run meant to disable
# gameoverlayrenderer loaded it anyway, and the override looked like it had been
# tested when it had not.
if [ -n "$BACKEND_OVERRIDES" ] && [ -n "$WINEDLLOVERRIDES" ]; then
    ALL_OVERRIDES="$BACKEND_OVERRIDES;$WINEDLLOVERRIDES"
else
    ALL_OVERRIDES="${BACKEND_OVERRIDES}${WINEDLLOVERRIDES}"
fi

# --- assemble environment -------------------------------------------------
env_args=(
    WINEPREFIX="$PREFIX_PATH"
    PATH="$BIN:$PATH"
)
# Deliberately NOT setting DYLD_FALLBACK_LIBRARY_PATH.
#
# The runtime carries its own copies of the libraries Wine dlopens, and
# configure was seeded with absolute paths into that bundle, so nothing needs
# the variable (bin/bundle-libs, docs/RUNTIME.md §1).
#
# Setting it anyway would be worse than useless: it would *mask* a bundle
# regression, and this whole class of bug is invisible when it is masked --
# a missing library produces no error, just no Vulkan, or no fonts, or no TLS.
# Leaving it unset means a regression fails loudly and immediately.

# Chromium's software compositor runs in the viz process and blits into a window
# owned by the browser process; Wine's window surfaces are per-process, so those
# pixels are dropped and the window is black. --in-process-gpu makes viz a thread
# of the browser process. See docs/RUNTIME.md.
#
# This is set for EVERY launch, not just the Steam client profile, and that is
# deliberate: the injection is keyed on the image name, so it is inert for
# anything that is not steamwebhelper.exe. Scoping it per-profile bought nothing
# and actively caused a black client -- launching a game directly starts Steam
# through steam_api.dll with whatever environment the game got, and the overlay
# is CEF too. A profile can still override it via PROFILE_ENV.
env_args+=( 'WINE_APPEND_ARGS=steamwebhelper.exe=--no-sandbox --in-process-gpu --disable-gpu' )

# Deliberately NOT setting VK_ICD_FILENAMES. Pointing it at MoltenVK's own ICD
# is actively harmful: that manifest carries is_portability_driver:true, so the
# Khronos loader hides the driver from any application that does not opt into
# VK_KHR_portability_enumeration -- Steam does not, and got
# VK_ERROR_INCOMPATIBLE_DRIVER. Left unset, the loader's default search finds
# MoltenVK correctly. See docs/RUNTIME.md ("MoltenVK portability flag").
[ -n "$ALL_OVERRIDES" ] && env_args+=( WINEDLLOVERRIDES="$ALL_OVERRIDES" )
# ${arr[@]+"${arr[@]}"} expands to nothing when empty, safely on bash 3.2.
env_args+=( ${BACKEND_ENV[@]+"${BACKEND_ENV[@]}"} )
env_args+=( ${PROFILE_ENV[@]+"${PROFILE_ENV[@]}"} )

case "${1:-}" in
    --shell)
        info "profile=$PROFILE runtime=$RUNTIME backend=$BACKEND prefix=$PREFIX"
        exec env "${env_args[@]}" zsh
        ;;
    --winecfg)
        exec env "${env_args[@]}" "$BIN/winecfg"
        ;;
esac

[ -n "$EXE" ] || die "profile '$PROFILE' defines no EXE"

info "launching $PROFILE  [runtime=$RUNTIME backend=$BACKEND prefix=$PREFIX]"
cd "${WORKDIR:-$(dirname "$EXE")}" 2>/dev/null || true
exec env "${env_args[@]}" "$BIN/wine" "$EXE" ${ARGS:-} "$@"
