#!/bin/bash
# Launch a game from its profile.
#
#   bin/gamerun <profile> [extra args passed to the exe]
#   bin/gamerun <profile> --shell        # drop into a shell with the env set up
#   bin/gamerun <profile> --winecfg      # run winecfg in that prefix
#
# A profile (profiles/<name>.env) selects runtime + prefix + backend + exe.
# Swapping graphics backend is a one-line edit there, which is the whole point:
# the same game, prefix and runtime can be A/B tested across DXMT / DXVK / GL.

source "$(dirname "$0")/common.sh"

PROFILE="${1:-}"
[ -n "$PROFILE" ] || die "usage: gamerun <profile> [args...]"
shift

load_profile "$PROFILE"

[ -d "$PREFIX_PATH" ] || die "prefix '$PREFIX' does not exist -- run: bin/mkprefix $PREFIX"
BIN="$(runtime_bin "$RUNTIME")"


# --- backend --------------------------------------------------------------
# Each backend dir carries a backend.conf defining BACKEND_OVERRIDES and,
# optionally, BACKEND_ENV (extra env assignments) and BACKEND_DYLD_PATHS.
BACKEND_OVERRIDES=""
BACKEND_ENV=()
if [ "$BACKEND" != "none" ]; then
    conf="$BACKENDS_DIR/$BACKEND/backend.conf"
    [ -f "$conf" ] || die "backend '$BACKEND' has no backend.conf at $conf"
    # shellcheck disable=SC1090
    source "$conf"
fi

# Profile-level overrides win over backend defaults; both are merged.
ALL_OVERRIDES="${BACKEND_OVERRIDES}${WINEDLLOVERRIDES:+;$WINEDLLOVERRIDES}"

# --- assemble environment -------------------------------------------------
env_args=(
    WINEPREFIX="$PREFIX_PATH"
    PATH="$BIN:$PATH"
    DYLD_FALLBACK_LIBRARY_PATH="$(runtime_dyld_path "$RUNTIME"):${DYLD_FALLBACK_LIBRARY_PATH:-/usr/lib}"
)
# macOS grants OpenGL 3.2+ only via a forward-compatible core profile, and
# upstream winemac.drv rejects 3.2+ requests that lack that bit -- which wined3d
# does not set, so it silently drops to a legacy 2.1 context (D3D feature level
# 9_x). Our patched winemac.drv sets the bit when this is 1.
env_args+=( WINEMAC_FWD_COMPAT_GL_CTX=1 )

icd="$(runtime_vk_icd "$RUNTIME")"
[ -f "$icd" ] && env_args+=( VK_ICD_FILENAMES="$icd" )
[ -n "$ALL_OVERRIDES" ] && env_args+=( WINEDLLOVERRIDES="$ALL_OVERRIDES" )
# ${arr[@]+"${arr[@]}"} expands to nothing when empty, safely on bash 3.2.
env_args+=( ${BACKEND_ENV[@]+"${BACKEND_ENV[@]}"} )
env_args+=( ${PROFILE_ENV[@]+"${PROFILE_ENV[@]}"} )

case "${1:-}" in
    --shell)
        info "profile=$PROFILE runtime=$RUNTIME backend=$BACKEND prefix=$PREFIX"
        exec env "${env_args[@]}" zsh
        ;;
    --winecfg)
        exec env "${env_args[@]}" "$BIN/winecfg"
        ;;
esac

[ -n "$EXE" ] || die "profile '$PROFILE' defines no EXE"

info "launching $PROFILE  [runtime=$RUNTIME backend=$BACKEND prefix=$PREFIX]"
cd "${WORKDIR:-$(dirname "$EXE")}" 2>/dev/null || true
exec env "${env_args[@]}" "$BIN/wine" "$EXE" ${ARGS:-} "$@"
