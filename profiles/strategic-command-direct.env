# Strategic Command WWII, launched by running the game exe directly.
#
# This is the DEBUG profile. `strategic-command.env` is the real one -- it goes
# through `steam.exe -applaunch`, which is how a Steam game is supposed to start
# and the only way the .NET Launcher.exe step gets exercised.
#
# Why a direct profile exists at all: -applaunch means the game is a grandchild
# of Steam (steam.exe -> Launcher.exe -> game), so it inherits WINEDEBUG from the
# whole tree and every trace is buried under Steam's own output. Running the exe
# directly puts the environment exactly where we want it and skips a UI click.
#
# PRECONDITION: Steam must already be running in this prefix.
#
#   bin/gamerun steam &        # wait for it to finish logging in
#   bin/gamerun strategic-command-direct
#
# With Steam up, steam_api.dll connects to the running client and the game
# proceeds. With Steam down it instead re-launches the game via
# steam://run/593030 and exits 53 -- see docs/RUNTIME.md §9. That exit-53 note
# used to read as "direct launch never works"; the real rule is that it works
# if and only if Steam is already online.

RUNTIME="winecx-26.3.0-sse-x86_64"
PREFIX="steam-winecx"

# Kept at "none" deliberately. This is an SDL 1.2 / DirectDraw title -- Wine's
# ddraw talks to wined3d directly and never loads d3d9.dll -- so DXVK's d3d9=n
# override cannot be in the path. Setting it only adds noise to a trace.
# See docs/NOTEBOOK.md, "do not re-chase these".
BACKEND="none"

EXE='S:\SteamLibrary\steamapps\common\Strategic Command WWII War in Europe\SC3-WWII War in Europe.exe'
WORKDIR="$LIBRARY_DIR/SteamLibrary/steamapps/common/Strategic Command WWII War in Europe"

ARGS=""

# gamerun appends PROFILE_ENV last, so whatever is set here beats the caller's
# environment. Defaulting through ${WINEDEBUG:-...} hands control back, which is
# the whole point of this profile:
#
#   WINEDEBUG=+seh,+pid,+timestamp bin/gamerun strategic-command-direct
PROFILE_ENV=(
    "WINEDEBUG=${WINEDEBUG:--all}"
)

# Same default-through trick, so the overlay can be toggled per run:
#   WINEDLLOVERRIDES='gameoverlayrenderer=' bin/gamerun strategic-command-direct
WINEDLLOVERRIDES="${WINEDLLOVERRIDES-}"
