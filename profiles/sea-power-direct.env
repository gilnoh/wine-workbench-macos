# Sea Power, launched by running the game exe directly -- the DEBUG profile;
# `sea-power.env` is the real one. Same split as iron-nest-direct.env.
#
# PRECONDITION: Steam must already be running in this prefix, and the game dir
# needs steam_appid.txt (1286220), or steam_api re-launches the exe through
# Steam and this environment is lost (RUNTIME.md section 9).
#
#   bin/gamerun steam &        # wait for it to finish logging in
#   bin/gamerun sea-power-direct
#
# Why this profile exists (2026-10-10): missions spawn units incompletely or not
# at all. The game runs part of its logic as JavaScript in an embedded Chromium
# (Vuplex 3D WebView; host exe "Vuplex WebView.vuplex", page
# StreamingAssets/original/scripts/launch.html). WINE_APPEND_ARGS can only name
# one image, and under -applaunch that slot belongs to steamwebhelper.exe -- so
# the script engine can only be given a DevTools port on a direct launch.
#
#   curl -s http://127.0.0.1:9222/json      # pages the script engine hosts
#
# The port is on by default. VUPLEX_ARGS overrides the whole spec; to run with
# no injection at all, name an image that never exists:
#
#   VUPLEX_ARGS='none=' bin/gamerun sea-power-direct
#
# On exit, a winedbg "Program Error" dialog for "Vuplex WebView.vuplex" appears
# with or without the port (seen 2026-10-10 on a probed run AND on a run with
# VUPLEX_ARGS='none='), and Sea Power.exe then spins one thread at 100% instead
# of exiting -- stop it with bin/killwine --game-only.

RUNTIME="winecx-26.3.0-sse-x86_64"
PREFIX="steam-winecx"

# The per-app key (see sea-power.env) selects DXMT either way; BACKEND= also
# reaches a direct launch.
BACKEND="dxmt-0.80-winecx-26.3.0-sse"

EXE='S:\SteamLibrary\steamapps\common\Sea Power\Sea Power.exe'
WORKDIR="$LIBRARY_DIR/SteamLibrary/steamapps/common/Sea Power"

ARGS=""

# PROFILE_ENV is applied last, so this replaces gamerun's steamwebhelper spec --
# harmless here, Steam is already running with its own environment.
PROFILE_ENV=(
    "WINEDEBUG=${WINEDEBUG:--all}"
    "WINE_APPEND_ARGS=${VUPLEX_ARGS-Vuplex WebView.vuplex=--remote-debugging-port=9222 --remote-allow-origins=*}"
)

WINEDLLOVERRIDES="${WINEDLLOVERRIDES-}"
