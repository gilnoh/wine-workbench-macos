# Task Force Admiral (Steam appid 1281220).
# Steam launches bin/master/TFA.exe with bin/master as the working directory.
# Its plugins.cfg enables RenderSystem_GL3Plus; keep Wine's builtin OpenGL
# path for the baseline. Installation and run results live in docs/NOTEBOOK.md.
#
# Launch through Steam so it supplies the game's working directory and session.
# WINEDEBUG below reaches the game only if this launch starts the Steam client;
# an already-running client supplies its own environment (docs/RUNTIME.md §9).

RUNTIME="winecx-26.3.0-sse-x86_64"
PREFIX="steam-winecx"
BACKEND="none"

EXE='C:\Program Files (x86)\Steam\steam.exe'
WORKDIR="$PREFIXES_DIR/steam-winecx/drive_c/Program Files (x86)/Steam"
ARGS="-applaunch 1281220"

PROFILE_ENV=(
    "WINEDEBUG=${WINEDEBUG--all}"
)

WINEDLLOVERRIDES=""
