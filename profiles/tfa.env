# Task Force Admiral: direct launch with the sister project's Mesa GL bundle.
# Start workbench Steam first: bin/gamerun steam; wait for login, then use this
# profile from another terminal. Direct launch preserves the graphics/audio env
# even when Steam was started with the normal runtime. See docs/NOTEBOOK.md.
# The original Apple OpenGL/Steam launch is retained as tfa-baseline.

RUNTIME="winecx-26.3.0-mesa-gl-x86_64"
PREFIX="steam-winecx"
BACKEND="none"

TFA_GRAPHICS_BUNDLE="${TFA_GRAPHICS_BUNDLE:-$GAMES_ROOT/../mesa-wine-gl/build/graphics-bundle-swap-fix}"
EXE='S:\SteamLibrary\steamapps\common\Task Force Admiral\bin\master\TFA.exe'
WORKDIR="$LIBRARY_DIR/SteamLibrary/steamapps/common/Task Force Admiral/bin/master"
ARGS=""

# Keep experimental overrides from an earlier shell out of this known setup.
# These unsets affect only this launcher process, never the caller's shell.
for tfa_env_key in $(compgen -e); do
    case "$tfa_env_key" in
        MESA_*|ZINK_*|VK_*|DYLD_*|ALSOFT_*|CX_FWD_COMPAT_GL_CTX|WINEDLLOVERRIDES)
            unset "$tfa_env_key" ;;
    esac
done
unset tfa_env_key

PROFILE_ENV=(
    "WINEDEBUG=${WINEDEBUG--all,+loaddll}"
    "SteamAppId=1281220"
    "SteamGameId=1281220"
    "MESA_WINE_LIB=$TFA_GRAPHICS_BUNDLE/lib/libmesa_wine.dylib"
    "VK_DRIVER_FILES=$TFA_GRAPHICS_BUNDLE/kosmickrisp.json"
    "MESA_KK_EXPERIMENTAL=xfb_gs_probe,custom_border,rgb32_texel"
    "ALSOFT_DRIVERS=wasapi"
    "ALSOFT_LOGLEVEL=3"
)
WINEDLLOVERRIDES=""

profile_preflight() {
    python3 - "$PREFIX_PATH" "$TFA_GRAPHICS_BUNDLE" "$WORKDIR" <<'PY'
import hashlib
import json
from pathlib import Path
import subprocess
import sys

prefix, bundle, game = map(lambda p: Path(p).resolve(), sys.argv[1:])
def fail(message):
    raise SystemExit('error: ' + message)
if not (game / 'TFA.exe').is_file():
    fail(f'TFA is not installed at {game}')
try:
    package = json.loads((bundle / 'manifest.json').read_text())
    if not (bundle / 'kosmickrisp.json').is_file():
        fail(f'Missing KosmicKrisp manifest in {bundle}')
    for library in package['libraries'].values():
        path = bundle / 'lib' / library['name']
        if hashlib.sha256(path.read_bytes()).hexdigest() != library['bundled_sha256']:
            fail(f'Graphics library differs from bundle manifest: {path}')
except (OSError, ValueError, KeyError) as error:
    fail(f'Cannot validate graphics bundle {bundle}: {error}')
try:
    processes = subprocess.check_output(['/bin/ps', '-axo', 'pid=,comm='], text=True)
except subprocess.CalledProcessError:
    fail('Cannot inspect Steam/TFA processes; refusing an unchecked launch')
steam_ready = False
expected = 'n' + str(prefix / 'drive_c/Program Files (x86)/Steam/steam.exe').lower()
for line in processes.splitlines():
    pid, command = line.strip().split(None, 1)
    if command.lower().endswith('tfa.exe'):
        fail('TFA is already running; quit it before launching another instance')
    if command.lower().endswith('steam.exe'):
        files = subprocess.run(['/usr/sbin/lsof', '-a', '-p', pid, '-Fn'],
                               text=True, capture_output=True)
        if expected in files.stdout.lower().splitlines():
            steam_ready = True
        else:
            fail('Steam is running outside the selected prefix, or its prefix cannot be verified. '
                 'Close that client before starting workbench Steam; do not run two clients.')
if not steam_ready:
    fail('Start bin/gamerun steam in this prefix and wait for login, then retry bin/gamerun tfa')
PY
}
