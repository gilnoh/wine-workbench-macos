# XCOM: Chimera Squad  (Steam appid 882100)
#
# The second D3D11 title here, and chosen for ENGINE diversity rather than for
# load: Iron Nest is Unity 6, this is Unreal Engine 3. Whether DXMT handles a
# completely different renderer's D3D11 usage is a more useful question than
# whether it survives more triangles.
#
#   engine        Unreal Engine 3
#   exe           Binaries/Win64/xcom.exe -- PE32+ x86_64
#   graphics      Direct3D 11 (PCGamingWiki also lists an OpenGL 4 path)
#   anti-cheat    none
#   size          15 GB
#
# The 2K Launcher is gone (see 2kLauncherRemoved.txt in the game directory), so
# Steam runs xcom.exe directly. That removes a launcher that shipped
# QtWebEngineProcess.exe -- i.e. Chromium, the same class of thing as
# steamwebhelper and its black-window problem. Worth knowing if an older build
# or another 2K title turns up.

RUNTIME="winecx-26.3.0-sse-x86_64"
PREFIX="steam-winecx"

# See docs/RUNTIME.md section 10 for why a D3D11 title cannot use wined3d on
# this platform at all: MoltenVK has no geometryShader, so the adapter caps at
# feature level 9_3 and D3D11CreateDevice returns 0x80004005.
#
# ⚠️ AND THIS LINE ALONE DOES NOT SELECT THE BACKEND for a Steam game. BACKEND=
# exports WINEDLLOVERRIDES, which does not cross the Steam client hand-off. The
# backend is really selected by a per-application registry key, keyed on the
# executable that creates the D3D device -- which for this game is xcom.exe,
# NOT launcher.exe:
#
#   bin/backend-install dxmt-0.80-winecx-26.3.0-sse steam-winecx \
#       winecx-26.3.0-sse-x86_64 --app 'xcom.exe'
#
# See docs/RUNTIME.md section 9, "BACKEND= in a profile does NOT reach a
# Steam-launched game".
BACKEND="dxmt-0.80-winecx-26.3.0-sse"

EXE='C:\Program Files (x86)\Steam\steam.exe'
WORKDIR="$PREFIXES_DIR/steam-winecx/drive_c/Program Files (x86)/Steam"

ARGS="-applaunch 882100"

PROFILE_ENV=(
    "WINEDEBUG=${WINEDEBUG--all}"
)

WINEDLLOVERRIDES=""
