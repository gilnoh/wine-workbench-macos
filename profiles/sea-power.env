# Sea Power: Naval Combat in the Missile Age  (Steam appid 1286220)
#
# ✅ PLAYS (2026-10-10) -- needs patches/wine-0008. Without it missions spawn
# ships incompletely or not at all: Unity's Mono reads the last error from
# gs:[0x68], which on macOS was not the TEB's, so File.Exists() lied and the
# game loaded ~2300 data files from nonexistent paths. docs/NEXT.md, 2026-10-10.
#
# Known: on exit a winedbg dialog for "Vuplex WebView.vuplex" may appear and the
# game spins at 100% instead of quitting; bin/killwine --game-only clears it.
#
#   engine        Unity 6000.0.67f1
#   exe           Sea Power.exe -- PE32+ x86_64, the Unity player, launched
#                 directly by Steam (no launcher; appinfo has a single launch
#                 option, no arguments)
#   graphics      store page: "DirectX: Version 11". Ships D3D12/D3D12Core.dll,
#                 so D3D12 is in its API list too -- which API Unity actually
#                 picks is not yet measured (Player.log says, on first launch)
#   also ships    Vuplex WebView (embedded Chromium), Noesis GUI, sentry-native
#   steam_appid   none shipped -- a *-direct.env profile needs one (RUNTIME.md §9)
#   size          9.7 GB download, 18 GB on disk

RUNTIME="winecx-26.3.0-sse-x86_64"
PREFIX="steam-winecx"

# D3D11, so wined3d cannot run it on this platform (RUNTIME.md §10). BACKEND=
# alone does not reach a Steam-launched game; the per-app key does:
#
#   bin/backend-install dxmt-0.80-winecx-26.3.0-sse steam-winecx \
#       winecx-26.3.0-sse-x86_64 --app 'Sea Power.exe' --app-only
BACKEND="dxmt-0.80-winecx-26.3.0-sse"

EXE='C:\Program Files (x86)\Steam\steam.exe'
WORKDIR="$PREFIXES_DIR/steam-winecx/drive_c/Program Files (x86)/Steam"

ARGS="-applaunch 1286220"

PROFILE_ENV=(
    "WINEDEBUG=${WINEDEBUG--all}"
)

WINEDLLOVERRIDES=""
