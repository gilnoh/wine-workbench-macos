# Strategic Command WWII: War in Europe  (Steam appid 593030)
#
# First 32-bit, D3D9 title in this environment -- everything debugged so far was
# 64-bit Chromium. Expect the interesting problems to be in different places.
#
# Installed in the shared library on S:, so it is not tied to this prefix and a
# per-game prefix later costs nothing. Note Steam creates a SteamLibrary/
# subfolder under whatever mount point you register, hence the path below.

RUNTIME="wine-11.14-x86_64"
PREFIX="steam-base"

# Start with no translation layer at all: wined3d turns D3D9 into OpenGL, which
# is the path that leads to mesa_gl_to_metal. If it is slow or wrong, DXVK-9 is
# the comparison baseline -- worth measuring both rather than assuming.
BACKEND="none"

# Launch through Steam rather than running the exe directly.
#
# Running SC3-WWII directly always exits 53: steam_api.dll re-launches the game
# via steam://run/<appid> and quits, and that hand-off goes through Wine's URL
# handler, which does not inherit our environment -- so the Steam it starts has
# no WINE_APPEND_ARGS and comes up black. -applaunch is the supported entry
# point: Steam owns the launch, and because gamerun starts *this* process, the
# whole tree inherits the environment we want.
EXE='C:\Program Files (x86)\Steam\steam.exe'
WORKDIR="$PREFIXES_DIR/steam-base/drive_c/Program Files (x86)/Steam"

ARGS="-applaunch 593030"

PROFILE_ENV=(
    WINEDEBUG=-all
)

# Nothing forced yet. Note bin/gamerun sets WINE_APPEND_ARGS for every launch:
# a Steam game still needs it, because steam_api.dll will start the client and
# the overlay is CEF -- launching without it leaves a black Steam window.
WINEDLLOVERRIDES=""
