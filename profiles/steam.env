# The base Steam client prefix. Games get their own prefixes/profiles; this one
# exists to run the client itself (login, installs, updates).
#
# Reminder: never run two prefixes' Steam clients at once -- they share
# S:\steamapps and would fight over appmanifest state.

RUNTIME="wine-11.14-x86_64"
BACKEND="none"
PREFIX="steam-base"

EXE='C:\Program Files (x86)\Steam\Steam.exe'
WORKDIR="$PREFIXES_DIR/steam-base/drive_c/Program Files (x86)/Steam"

# Steam's UI is rendered entirely by CEF (steamwebhelper). Under Wine its GPU
# process cannot initialise ANGLE -- hardware Vulkan is rejected and software
# SwANGLE also fails -- so the GPU process exits and NO WINDOW EVER APPEARS,
# with the client still running happily in the background.
#
# -cef-disable-gpu makes CEF rasterise on the CPU. Costs nothing that matters:
# this is a launcher, and games get the real GPU through their own backend.
# NOTE: -cef-disable-gpu is deliberately NOT set. With vulkan-1 forced native
# (below), CEF can reach its bundled SwiftShader, so let ANGLE initialise
# normally: hardware Vulkan will fail over to SwANGLE, which composites in
# software. Disabling the GPU process entirely left the window black.
ARGS=""

PROFILE_ENV=(
    WINEDEBUG=-all
)

# Steam's CEF bundles its own vulkan-1.dll plus vk_swiftshader.dll for software
# rendering. Wine prefers its builtin vulkan-1 (winevulkan), which hijacks the
# load and then finds no usable host driver -- MoltenVK is hidden behind the
# loader's portability filter, giving VK_ERROR_INCOMPATIBLE_DRIVER (-9). ANGLE
# then fails on both hardware *and* SwANGLE, the GPU process exits, and the
# window paints black.
#
# Forcing vulkan-1 native lets CEF load its own loader and reach SwiftShader.
# Safe here because we never launch games through the Steam client -- games get
# their own profile and prefix, where vulkan-1 stays builtin for DXVK.
WINEDLLOVERRIDES="vulkan-1=n"
