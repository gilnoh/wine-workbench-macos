# The base Steam client prefix. Games get their own prefixes/profiles; this one
# exists to run the client itself (login, installs, updates).
#
# Reminder: never run two prefixes' Steam clients at once -- they share
# S:\steamapps and would fight over appmanifest state.

RUNTIME="wine-11.14-x86_64"
BACKEND="none"
PREFIX="steam-base"

EXE='C:\Program Files (x86)\Steam\Steam.exe'
WORKDIR="$PREFIXES_DIR/steam-base/drive_c/Program Files (x86)/Steam"

# Steam's UI is rendered entirely by CEF (steamwebhelper). Under Wine its GPU
# process cannot initialise ANGLE -- hardware Vulkan is rejected and software
# SwANGLE also fails -- so the GPU process exits and NO WINDOW EVER APPEARS,
# with the client still running happily in the background.
#
# -cef-disable-gpu makes CEF rasterise on the CPU. Costs nothing that matters:
# this is a launcher, and games get the real GPU through their own backend.
ARGS="-cef-disable-gpu"

PROFILE_ENV=(
    WINEDEBUG=-all
)
