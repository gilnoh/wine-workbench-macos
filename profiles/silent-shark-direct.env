# Silent Shark, launched directly (not via Steam) -- for experiments.
#
# Needs steam_appid.txt (4705650) in the game directory, or steamworks.js
# re-launches through steam://run and this process exits (RUNTIME.md §9).
# The Steam client must already be running and logged in.
#
# ARGS defaults to the switches that make steamwebhelper visible under Wine
# (bin/gamerun, WINE_APPEND_ARGS). Override per run: SHARK_ARGS="" bin/gamerun ...

RUNTIME="winecx-26.3.0-sse-x86_64"
PREFIX="steam-winecx"
BACKEND="none"

EXE='S:\SteamLibrary\steamapps\common\Silent Shark\Silent Shark.exe'
WORKDIR="$LIBRARY_DIR/SteamLibrary/steamapps/common/Silent Shark"
ARGS="${SHARK_ARGS---in-process-gpu --disable-gpu}"

PROFILE_ENV=(
    "WINEDEBUG=${WINEDEBUG--all}"
)

WINEDLLOVERRIDES=""
