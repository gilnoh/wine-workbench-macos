# Profile template. Copy to <game>.env and edit.
#
#   bin/gamerun <game>            launch
#   bin/gamerun <game> --shell    shell with this env
#   bin/gamerun <game> --winecfg  winecfg in this prefix

RUNTIME="wine-11.14-x86_64"   # dir under runtimes/
BACKEND="none"                # dir under backends/, or "none" for wined3d
PREFIX="example"              # dir under prefixes/

# Path as seen from inside the prefix. Shared game data is on drive S:.
EXE='S:\steamapps\common\Example Game\Example.exe'
ARGS=""
WORKDIR=""                    # host-side cwd; defaults to the exe's directory

# Extra env vars for tuning. Bash array of KEY=value.
PROFILE_ENV=(
    # WINEDEBUG=-all
    # DXMT_LOG_LEVEL=warn
    # DXMT_METALFX_SPATIAL_SWAPCHAIN=1
)

# Merged on top of the backend's own overrides.
WINEDLLOVERRIDES=""
