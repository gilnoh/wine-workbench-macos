# IRON NEST, launched by running the game exe directly.
#
# This is the DEBUG profile; `iron-nest.env` is the real one. Same split, and
# the same reason, as strategic-command-direct.env: -applaunch makes the game a
# child of Steam, so it inherits WINEDEBUG from the whole tree and every trace
# is buried under Steam's own output. Running the exe directly puts the
# environment exactly where we want it.
#
# PRECONDITION: Steam must already be running in this prefix.
#
#   bin/gamerun steam &        # wait for it to finish logging in
#   bin/gamerun iron-nest-direct
#
# Unity accepts its own switches here, which is the point of this profile:
#
#   bin/gamerun iron-nest-direct -force-d3d11     # pin the graphics API
#   bin/gamerun iron-nest-direct -force-d3d12
#   bin/gamerun iron-nest-direct -screen-width 1280 -screen-height 720 -screen-fullscreen 0
#
# The game writes its own log to
#   drive_c/users/<user>/AppData/LocalLow/Iron Nest/Iron Nest_ Heavy Turret Simulator/Player.log
# whose first lines record the Unity version and the graphics device actually
# selected. That log, not the store page, is the measurement.

RUNTIME="winecx-26.3.0-sse-x86_64"
PREFIX="steam-winecx"

# See iron-nest.env for why DXMT is required rather than optional. Override per
# run to reproduce the wined3d baseline:
#   BACKEND=none bin/gamerun iron-nest-direct
BACKEND="dxmt-0.80"

EXE='S:\SteamLibrary\steamapps\common\Iron Nest Heavy Turret Simulator\Iron Nest Heavy Turret Simulator.exe'
WORKDIR="$LIBRARY_DIR/SteamLibrary/steamapps/common/Iron Nest Heavy Turret Simulator"

ARGS=""

PROFILE_ENV=(
    "WINEDEBUG=${WINEDEBUG:--all}"
)

WINEDLLOVERRIDES="${WINEDLLOVERRIDES-}"
