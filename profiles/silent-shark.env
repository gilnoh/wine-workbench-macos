# Silent Shark  (Steam appid 4705650, John Goering, released 2026-08-12)
#
# Status: installed 2026-10-15; plays (user report, Steam-launched runs 2026-10-15).
#
#   engine        Electron 35.7.5 (Chrome 134.0.6998.205) -- a web app, not a
#                 game engine. Renders through ANGLE (libEGL/libGLESv2.dll),
#                 which on Windows defaults to D3D11; ships vk_swiftshader as
#                 Chromium's software fallback.
#   exe           Silent Shark.exe -- PE32+ x86_64, launched directly by Steam
#   graphics      store page: "DirectX: Version 11" -- that is ANGLE's backend
#   also          a native macOS build exists; this profile is the Windows one
#   steam_appid   none shipped -- a *-direct.env profile needs one (RUNTIME.md §9)
#   size          145 MB download, 330 MB on disk, buildid 25888063
#
# Chromium is the same class as steamwebhelper: if the GPU/viz process draws
# into the window from another process, Wine drops the pixels (bin/gamerun,
# WINE_APPEND_ARGS). WINE_APPEND_ARGS matches one image only, and it is
# steamwebhelper.exe -- so it does nothing for this exe.

RUNTIME="winecx-26.3.0-sse-x86_64"
PREFIX="steam-winecx"

# No backend yet: measure what Chromium does on wined3d first.
BACKEND="none"

EXE='C:\Program Files (x86)\Steam\steam.exe'
WORKDIR="$PREFIXES_DIR/steam-winecx/drive_c/Program Files (x86)/Steam"

ARGS="-applaunch 4705650"

PROFILE_ENV=(
    "WINEDEBUG=${WINEDEBUG--all}"
)

WINEDLLOVERRIDES=""
