#!/bin/bash
set -euo pipefail
ROOT="$(cd "$(dirname "$0")" && pwd)"
export PATH="$ROOT/tools:$ROOT/runtime/bin:/usr/bin:/bin:/usr/sbin:/sbin"
# Explicit new override, legacy override, existing legacy bottle, then new default.
legacy_prefix="$HOME/Library/Application Support/TFA Wine Preview/prefix"
default_prefix="$HOME/Library/Application Support/GL-support-wine/prefix"
if [ -d "$legacy_prefix" ]; then default_prefix="$legacy_prefix"; fi
export WINEPREFIX="${GL_WINE_PREFIX:-${TFA_PREFIX:-$default_prefix}}"
export WINE="$ROOT/runtime/bin/wine" WINESERVER="$ROOT/runtime/bin/wineserver"
for key in $(compgen -e); do case "$key" in DYLD_*|MESA_*|VK_*|ZINK_*|ALSOFT_*|GST_*) unset "$key";; esac; done
export WINEMSYNC=1 WINEDEBUG="${WINEDEBUG:--all}"
export WINE_APPEND_ARGS='steamwebhelper.exe=--no-sandbox --in-process-gpu --disable-gpu'
export GST_PLUGIN_SYSTEM_PATH="$ROOT/runtime/lib/bundled/gstreamer-1.0" GST_PLUGIN_PATH=
export GST_PLUGIN_SCANNER="$ROOT/runtime/lib/bundled/gst-plugin-scanner"
export GST_REGISTRY="$WINEPREFIX/gstreamer-registry.bin"
STEAM="$WINEPREFIX/drive_c/Program Files (x86)/Steam"
check_other_steam() {
 local pid files
 for pid in $(/usr/bin/pgrep -x steam.exe || true); do
  files=$(/usr/sbin/lsof -a -p "$pid" -Fn 2>/dev/null || true)
  printf '%s\n' "$files" | /usr/bin/grep -Fqx "n$STEAM/steam.exe" || { echo 'Exit the other Windows Steam client first.' >&2; exit 1; }
 done
}
case "${1:-help}" in
 setup)
 check_other_steam
 mkdir -p "$WINEPREFIX"; export W_CACHE="$(dirname "$WINEPREFIX")/downloads"
 mkdir -p "$W_CACHE"
 WINEDLLOVERRIDES='mscoree,mshtml=' "$WINE" wineboot -u
 "$WINESERVER" -w
 # Keep Windows personal folders inside this bottle.
 for folder in Documents Downloads Music Pictures Videos Desktop; do
  for user in "$WINEPREFIX"/drive_c/users/*; do
   [ -d "$user" ] || continue
   [ ! -L "$user/$folder" ] || rm "$user/$folder"
   mkdir -p "$user/$folder"
  done
 done
 "$ROOT/tools/winetricks" -q corefonts d3dcompiler_47 vcrun2022
 "$WINESERVER" -w
 grep -q '"\*vcruntime140"' "$WINEPREFIX/user.reg" || { echo 'VC++ provisioning failed'; exit 1; }
 if [ ! -f "$STEAM/steam.exe" ]; then
  curl -fL --retry 3 https://cdn.akamai.steamstatic.com/client/installer/SteamSetup.exe -o "$W_CACHE/SteamSetup.exe"
  echo "7d3654531c32d941b8cae81c4137fc542172bfa9635f169cb392f245a0a12bcb  $W_CACHE/SteamSetup.exe" | shasum -a 256 -c -
  "$WINE" "$W_CACHE/SteamSetup.exe" /S
 fi
 echo 'Setup complete. Run ./gl-support-wine steam, log in, and install a game. For the tested TFA example, use the default C: library.'
 ;;
 steam)
 check_other_steam
 [ -f "$STEAM/steam.exe" ] || { echo 'Run ./gl-support-wine setup first'; exit 1; }
 cd "$STEAM"; exec "$WINE" "$STEAM/steam.exe"
 ;;
 play-tfa|play)
 check_other_steam
 /usr/bin/pgrep -x steam.exe >/dev/null || { echo 'Run ./gl-support-wine steam first and wait for login.'; exit 1; }
 game="$STEAM/steamapps/common/Task Force Admiral/bin/master"
 [ -f "$game/TFA.exe" ] || { echo 'Install TFA into the default C: Steam library first.'; exit 1; }
 export SteamAppId=1281220 SteamGameId=1281220 ALSOFT_DRIVERS=wasapi
 export MESA_WINE_LIB="$ROOT/graphics/lib/libmesa_wine.dylib" VK_DRIVER_FILES="$ROOT/graphics/kosmickrisp.json"
 export MESA_KK_EXPERIMENTAL=xfb_gs_probe,custom_border,rgb32_texel
 cd "$game"; exec "$WINE" ./TFA.exe
 ;;
 wine) shift; exec "$WINE" "$@" ;;
 *) echo 'Usage: ./gl-support-wine setup | steam | play-tfa | wine <arguments>'
 echo 'Optional: GL_WINE_PREFIX=/absolute/path/to/prefix ./gl-support-wine steam'
 ;;
esac
